# =============================================
# NEXUS AGENT — ENVIRONMENT VARIABLES
# =============================================

# 1. Get FREE from: console.groq.com → API Keys → Create API Key
GROQ_API_KEY=your_groq_key_here

# 2. Get from: newsapi.org → Register (free)
NEWS_API_KEY=your_newsapi_key_here

# 3. Get from: stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 4. Stripe Price IDs — Create in Stripe Dashboard → Products
STRIPE_PRO_PRICE_ID=price_your_pro_price_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_price_id

# 5. Secret key for Flask sessions (make this long and random)
SECRET_KEY=change_this_to_a_very_long_random_string_12345

# 6. Your website URL (change when deployed)
BASE_URL=http://localhost:5000
